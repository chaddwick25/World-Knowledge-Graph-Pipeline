# ── Frontend environment variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in the values. Vite automatically
# loads .env.local (gitignored) and exposes any var prefixed with VITE_ to
# the browser bundle via import.meta.env.

# CARTO basemap API key (optional but recommended).
# CARTO now requires an API key for their raster basemaps. Without a key,
# the map falls back to standard OSM raster tiles (light theme, no key).
# Keys are free within the 5M-tiles/month fair use limit — request one at:
#   https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=

# Django API base URL (REST + SSE). Defaults to localhost when unset.
# Build-time baked (Vite): set in Netlify UI for deploys, e.g.
#   VITE_API_BASE_URL=https://thanos.tail560528.ts.net/api
# The WebSocket URL is derived from this (http→ws, https→wss, /api stripped).
VITE_API_BASE_URL=
# Optional WebSocket override, if the WS host ever differs from the API host.
VITE_WS_BASE_URL=
