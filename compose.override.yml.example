services:
  backend:
    # Example local overrides. Copy this file to compose.override.yml and edit
    # values that differ from your machine or workflow. compose.override.yml
    # is gitignored — machine-specific paths never get released.
    environment:
      TZ: ${TZ:-America/Toronto}
      # Uncomment and adjust if your planet file name differs from the
      # settings.py default (history-260209.osm.pbf). Both variables are read
      # from the environment; leaving them unset falls back to the derived
      # defaults under BASE_DATA_DIR.
      # PLANET_OSM_FILE_PATH: /app/data/OSM-PBF-FILES/planet/latest.osm.pbf
      # POLYGON_FILES_DIR: /app/data/osm_polygon_files
    # The most common override: bind your host data disks into the app.
    # volumes:
    #   - /path/to/OSM-PBF-FILES:/app/data/OSM-PBF-FILES
    #   - /path/to/osm_polygon_files:/app/data/osm_polygon_files

  worker:
    environment:
      TZ: ${TZ:-America/Toronto}
      # Must match the backend: if you set POLYGON_FILES_DIR above, set it here
      # too, and point the volume at the *populated* host directory. A typo
      # here yields an empty mount and silently clips nothing — a real bug that
      # lived in this repo as `osm_polygon_file` (missing the "s").
      # POLYGON_FILES_DIR: /app/data/osm_polygon_files
      # The base compose pins the worker to GPU 1 (the pipeline compute
      # card, see docker-compose.yml comments). Override only to move it
      # to another card, e.g. the idle RTX 2070:
      # NVIDIA_VISIBLE_DEVICES: "0"
    # Optional: GPU reservations via deploy (valid alongside runtime:
    # nvidia in docker-compose.yml). The backend itself does no GPU work —
    # GPU compute lives in worker / ollama / ollama-research.
    # deploy:
    #   resources:
    #     reservations:
    #       devices:
    #         - driver: nvidia
    #           count: all
    #           capabilities: [gpu]
